    {
        "id": "b06ab3bca4ae7a63",
        "type": "function",
        "z": "707f1664494e885f",
        "name": "function 1",
        "func": "let base =\"VANAN_weight/pub\"\nconst p = msg.payload ?? {}\n\nlet data = {\n    weight: p.weightKELI.weight,\n    error: {\n        erCode: p.weightKELI?.error?.Code,\n        erText: p.weightKELI?.error?.Text\n    },\n    statusPLC: p.statusPLC,\n    statusIO: p.statusIO,\n    timestamp: new Date().toISOString()\n}\n\nlet msgs = []\n\nfor (let key in data) {\n    msgs.push({\n        topic: base + \"/\" + key,\n        payload: data[key]\n    })\n}\n\nreturn [msgs];",
