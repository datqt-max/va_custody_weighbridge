  <diagram id="pg9" name="9. CRC16 MODBUS">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p9_title" value="9. Thuật toán CRC16 MODBUS (dùng ở bước 0 và bước 40)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p9_st" value="CRC16(byte[0 .. last])" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p9_p1" value="crc := 16#FFFF   (CRC_INIT)&lt;br&gt;i := 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="185" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p9_d1" value="i ≤ last ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="290" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p9_p2" value="crc := crc XOR BYTE_TO_WORD(byte[i])&lt;br&gt;bit := 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="435" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p9_d2" value="bit ≤ 8 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="540" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p9_d3" value="(crc AND 16#0001)&lt;br&gt;≠ 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="685" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p9_p3" value="crc := SHR(crc, 1) XOR 16#A001   (CRC_POLY)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="830" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p9_p4" value="bit := bit + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="935" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p9_en" value="Trả về crcLo, crcHi" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="1040" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p9_lo" value="crcLo := WORD_TO_BYTE(crc)&lt;br&gt;crcHi := WORD_TO_BYTE(SHR(crc, 8))&lt;br&gt;(gửi Lo trước, Hi sau)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="240" height="80" as="geometry" />
