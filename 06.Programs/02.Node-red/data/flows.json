    {
        "id": "d4891be3db391a78",
        "type": "function",
        "z": "707f1664494e885f",
        "name": "dataWeight",
        "func": "const v = msg.payload ?? {};\nconst data = Array.isArray(v) ? v : v.data;\n\n// Cần đủ 3 thanh ghi: hiWord, loWord, errorCode\nif (!Array.isArray(data) || data.length < 3) {\n    return null;\n}\nconst ERROR_TEXT = {\n    //Tham số request Frame sai\n    8101: \"ERR_PARAM_ADDRESS\",\n    8102: \"ERR_PARAM_FUNCTION\",\n    8103: \"ERR_PARAM_REGISTER\",\n    8104: \"ERR_PARAM_QUANTITY\",\n    8105: \"ERR_PARAM_CRC\",\n    //Lỗi truyền thông từ PLC\n    8201: \"ERR_RX_RESET\",\n    8202: \"ERR_SEND\",\n    8203: \"ERR_RECEIVE\",\n    8204: \"ERR_TIMEOUT\",\n    8205: \"ERR_STATE_TIMEOUT\",\n    //Sai Frame nhận\n    8301: \"ERR_FRAME_TOO_SHORT\",\n    8302: \"ERR_FRAME_ADDRESS\",\n    8303: \"ERR_FRAME_FUNCTION\",\n    8304: \"ERR_FRAME_LENGTH\",\n    8305: \"ERR_FRAME_BYTE_COUNT\",\n    //Sai CRC nhận\n    8401: \"ERR_CRC_MISMATCH\",\n    //Đầu cân báo lỗi\n    8501: \"ERR_EXCEPTION\",\n    //Số liệu không hợp lệ\n    8601: \"ERR_WEIGHT_FORMAT\",\n    8602: \"ERR_WEIGHT_OVERLOAD\",\n    8603: \"ERR_DECIMAL_FORMAT\",\n    //Lỗi DB\n    8701: \"ERR_UNDEFINED_STATE\"\n}\nconst hiWord = data[0] & 0xFFFF;   // 400001\nconst loWord = data[1] & 0xFFFF;   // 400002\nconst er = data[2] & 0xFFFF; // 400003\nconst status = data[3]\nconst grossWeight = (hiWord << 16) | loWord;   // DInt có dấu (32-bit)\n\nconst erCode = er.toString(16).toUpperCase().padStart(4, \"0\");  // 400003\nconst erText = ERROR_TEXT [erCode]\nmsg.topic = \"weightKELI\";\nmsg.payload = {\n    weight: grossWeight,\n    error: {\n        Code: erCode,\n        Text: erText\n    }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 260,
        "wires": [
