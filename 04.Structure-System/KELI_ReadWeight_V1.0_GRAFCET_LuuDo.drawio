  <diagram id="pg8" name="8. Xử lý lỗi &amp; tự chạy lại">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8_title" value="8. Xử lý lỗi / retry (cuối mỗi chu kỳ) và tự khởi động lại" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p8_st" value="Xử lý lỗi / retry" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p8_d1" value="tempErrCode ≠ 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="185" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8_d2" value="tempRetryable AND&lt;br&gt;retryCounter &amp;gt; 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p8_p1" value="CÒN RETRY:&lt;br&gt;retryCounter := retryCounter − 1&lt;br&gt;instStateWatchdog(IN := FALSE)   (reset)&lt;br&gt;status := UNCERTAIN&lt;br&gt;statState := 10 → gửi lại lệnh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="485" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8_en" value="Kết thúc" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="630" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p8_w1" value="Không có lỗi: không làm gì" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="690" y="210" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p8_e1" value="HẾT RETRY / LỖI KHÔNG RETRY:&lt;br&gt;done := FALSE; busy := FALSE; error := TRUE&lt;br&gt;status := BAD&lt;br&gt;errorCode := tempErrCode&lt;br&gt;subStatus := tempSubStatus&lt;br&gt;restartPending := TRUE&lt;br&gt;instStateWatchdog(IN := FALSE)&lt;br&gt;statState := 0 (về IDLE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="460" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p8_lnk1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p8_st" target="p8_d1">
